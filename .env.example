# Target configuration
TARGET_URL=http://127.0.0.1:3000/api
CONNECTIONS=20
DURATION_SECONDS=10
RAMP_UP_SECONDS=0
WARM_UP_SECONDS=0

# Auth
AUTH_BEARER=
